# Example environment configuration for psa_sync_wrapper.sh
# Copy this file to a secure location (NOT in the repo) and customize for your environment
# Usage: /path/to/psa_sync_wrapper.sh -c /path/to/this-config.env

# =============================================================================
# SECURITY & CONFIGURATION BEST PRACTICES
# =============================================================================
#
# 1. Set restrictive permissions: chmod 600 this-config.env
# 2. Store in a secure location outside the repository
# 3. Use absolute paths for all directories
# 4. Validate configuration before production use:
#    ./psa_sync_wrapper.sh -c this-config.env --dry-run
# 5. Test with single step first:
#    ./psa_sync_wrapper.sh -c this-config.env --download-labels

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================
# Note: All paths should be absolute, not relative
# Note: Variables are automatically exported by the wrapper script to child processes

# Directory for log files (must exist, must be absolute path)
LOG_DIR="/path/to/logs"

# Directory for PSA label data (must exist, must be absolute path)
PSA_SYNC_DATA_DIR="/path/to/psa/data"

# Path to en-ops-utils repository (must exist, must be absolute path)
EN_OPS_UTILS_HOME="/path/to/en-ops-utils"

# Path to harvest-solr installation (must exist)
HARVEST_SOLR_HOME="/path/to/harvest-solr"

# Path to harvest config directory (must exist)
HARVEST_SOLR_CONF_HOME="/path/to/harvest-config"

# Path for Solr document output (must exist)
PDS4_SOLR_DOC_HOME="/path/to/solr-docs"

# Path to registry-manager-solr installation (must exist)
REGISTRY_MGR_SOLR_HOME="/path/to/registry-manager-solr"

# Email recipients for notifications (comma-separated, valid email format)
# Example: "team@example.org" or "user1@example.org,user2@example.org"
EMAIL_RECIPIENTS="your-team@example.org"

# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# =============================================================================

# Hostname label for email subject (default: uses system hostname)
# HOSTNAME_LABEL="production-server"

# Conda environment name (only needed for step 1 - download labels)
# Must be valid conda env if specified
# CONDA_ENV="conda-env"

# Conda installation path (optional, only if conda not in standard location)
# CONDA_HOME="/path/to/conda"

# Java installation path (only needed for step 2 - harvest)
# Must be absolute path to JDK if specified
# JAVA_HOME="/path/to/jdk"

# Harvest configuration file name (default: harvest-policy-ipda.xml)
# HARVEST_CONFIG_FILE="harvest-config-file.xml"

# Exclusion pattern for pds-sync-api (default: nasa/pds)
# PSA_SYNC_EXCLUDES="excludes/these"

# JVM memory options (default: -Xms2g -Xmx8g)
# JAVA_TOOL_OPTIONS="-Xms4g -Xmx16g"
