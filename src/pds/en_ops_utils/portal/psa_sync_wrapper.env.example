# Example environment configuration for psa_sync_wrapper.sh
# Usage: ./psa_sync_wrapper.sh -c dev.env  (or prod.env)
#
# Setup:
#   1. Copy this file: cp psa_sync_wrapper.env.example dev.env
#   2. Edit dev.env with your configuration
#   3. Set permissions: chmod 600 dev.env
#   4. Run: ./psa_sync_wrapper.sh -c dev.env
#
# Security:
#   ✓ .env files are protected by .gitignore and safe to store in this directory
#   ✓ Always use chmod 600 to restrict file access
#   ✓ Use absolute paths for all directories
#
# Testing:
#   - Test single step first: ./psa_sync_wrapper.sh -c dev.env --download-labels
#   - Validate full pipeline: ./psa_sync_wrapper.sh -c dev.env

# =============================================================================
# REQUIRED VARIABLES (depends on steps enabled and email settings)
# =============================================================================
# Note: Use absolute paths for all directories

# Directory for log files
LOG_DIR="/path/to/logs"

# Directory for PSA label data
PSA_SYNC_DATA_DIR="/path/to/psa/data"

# Path to en-ops-utils repository
EN_OPS_UTILS_HOME="/path/to/en-ops-utils"

# Path to harvest-solr installation
HARVEST_SOLR_HOME="/path/to/harvest-solr"

# Path to harvest config directory
HARVEST_SOLR_CONF_HOME="/path/to/harvest-config"

# Path for Solr document output
PDS4_SOLR_DOC_HOME="/path/to/solr-docs"

# Path to registry-manager-solr installation
REGISTRY_MGR_SOLR_HOME="/path/to/registry-manager-solr"

# Email recipients for notifications (comma-separated)
EMAIL_RECIPIENTS="your-team@example.org"

# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# =============================================================================

# Hostname label for email subject (default: uses system hostname)
# HOSTNAME_LABEL="production-server"

# Conda environment name (only needed for step 1 - download labels)
# Must be valid conda env if specified. If not set, uses system python.
# CONDA_ENV="conda-env"

# Conda installation path (only needed if conda not in standard location)
# Script tries: $CONDA_HOME, $HOME/.conda, /opt/conda, $CONDA_PREFIX/..
# CONDA_HOME="/path/to/miniconda3"

# Java installation path (only needed for step 2 - harvest)
# Must be absolute path to JDK if specified
# JAVA_HOME="/path/to/jdk"

# Harvest configuration file name (default: harvest-policy-ipda.xml)
# HARVEST_CONFIG_FILE="harvest-config-file.xml"

# Exclusion pattern for pds-sync-api (default: nasa/pds)
# PSA_SYNC_EXCLUDES="excludes/these"

# JVM memory options (default: -Xms2g -Xmx8g)
# JAVA_TOOL_OPTIONS="-Xms4g -Xmx16g"

# =============================================================================
# MULTI-MACHINE COORDINATION (Optional)
# =============================================================================
# For dev/prod workflows: Development creates marker file on success,
# production cron checks for marker and runs step 3 if found.
#
# Setup:
#   1. Set SUCCESS_MARKER_FILE to shared filesystem path (both machines)
#   2. Production: Configure check_and_load.env with same path
#   3. Production: Add to crontab (see check_and_load.env.example for details)
#

# Success marker file - shared filesystem path accessible from both machines
# Example: SUCCESS_MARKER_FILE="/shared/filesystem/.psa_sync_ready"
SUCCESS_MARKER_FILE=""
