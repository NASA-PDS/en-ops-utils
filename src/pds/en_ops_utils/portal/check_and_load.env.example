# Example configuration for check_and_load.sh (Production Machine)
#
# This file is for the PRODUCTION machine only.
# It coordinates with development via a shared filesystem marker.
#
# Setup:
#   1. Copy: cp check_and_load.env.example check_and_load.env
#   2. Edit paths below
#   3. Set permissions: chmod 600 check_and_load.env
#   4. Add to crontab:
#      0 */4 * * * cd /full/path/to/portal && ./check_and_load.sh -c check_and_load.env >> /var/log/psa-sync/check.log 2>&1
#
# Security:
#   ✓ check_and_load.env is protected by .gitignore
#   ✓ Use chmod 600 to restrict access
#
# Directory Structure (mirrored on both machines):
#   src/pds/en_ops_utils/portal/
#     ├── psa_sync_wrapper.sh      (same on both)
#     ├── dev.env                   (dev only, .gitignore protected)
#     ├── prod.env                  (prod only, .gitignore protected)
#     ├── check_and_load.sh         (prod only)
#     └── check_and_load.env        (prod only, .gitignore protected)
#
#   /shared/filesystem/
#     └── .psa_sync_ready           (marker: dev writes, prod reads)

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# Path to success marker file on shared filesystem
# This MUST match the SUCCESS_MARKER_FILE in dev.env on development machine
MARKER_FILE="/shared/filesystem/.psa_sync_ready"

# Path to psa_sync_wrapper.sh on production machine
# Can use relative path since scripts are in same directory
WRAPPER_SCRIPT="./psa_sync_wrapper.sh"

# Path to production config file for psa_sync_wrapper.sh
# This is the prod.env file containing production-specific settings
WRAPPER_CONFIG="./prod.env"

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# Maximum marker age in hours - ignore markers older than this
# Prevents processing stale data if development hasn't run recently
# MAX_AGE_HOURS=24

# Email address for error notifications
# Leave empty to disable email notifications
# ERROR_EMAIL="ops-team@example.org"
